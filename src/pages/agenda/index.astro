---
import Fil from '../../components/Fil.astro';
import FiltreCommune from '../../components/FiltreCommune.astro';
import Illustration from '../../components/Illustration.astro';
import ListeAgenda from '../../components/ListeAgenda.astro';
import Base from '../../layouts/Base.astro';
import { slugRubrique } from '../../lib/categories';
import { agendaVisibleMaintenant, communesDeRubrique } from '../../lib/contenu';
import { categorieParId } from '../../lib/site';

const categorie = categorieParId('agenda')!;
const evenements = await agendaVisibleMaintenant();
const communesRubrique = await communesDeRubrique('agenda');
---

<Base titre={categorie.titre} description={categorie.resume}>
  <Fil crumbs={[{ label: categorie.titre }]} />
  <header class="entete-page">
    {categorie.illustration && <Illustration image={categorie.illustration} />}
    <h1>{categorie.titre}</h1>
    <p class="chapo">{categorie.resume}</p>
  </header>
  <FiltreCommune communes={communesRubrique} rubrique={slugRubrique(categorie.titre)} />
  <ListeAgenda evenements={evenements} />
</Base>
