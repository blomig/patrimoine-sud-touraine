---
import Base from '../layouts/Base.astro';
import Statut from '../components/Statut.astro';
import { agendaVisibleMaintenant, extrait, hrefFiche } from '../lib/contenu';
import { formatPlage } from '../lib/dates';
import { chargerSite, listeCategories } from '../lib/site';
import { urlLicence, withBase } from '../lib/urls';

const site = chargerSite();
const categories = listeCategories();
const evenements = await agendaVisibleMaintenant();
---

<Base
  titre={site.titre}
  description="Patrimoine de Loches Sud Touraine : cinq rubriques, les communes du territoire et les prochaines animations."
>
  <section class="hero hero-court">
    <p class="chapo">
      Un cahier public du patrimoine de Loches Sud Touraine : bâtiments, personnes, événements
      et rendez-vous à venir.
    </p>
    <p>
      On entre par une rubrique, par la carte des communes, ou par les animations du moment.{' '}
      <a href={withBase('/qu-est-ce-que-ce-site/')}>Qu’est-ce que ce site ?</a>
    </p>
  </section>

  <section class="bloc" aria-labelledby="titre-categories">
    <h2 id="titre-categories">Cinq entrées</h2>
    <ul class="tuiles">
      {
        categories.map((categorie, index) => {
          const image = categorie.illustration;
          const licence = image ? urlLicence(image.licence) : null;
          return (
            <li class="tuile-bloc">
              <a class="tuile" href={withBase(`/${categorie.id}/`)}>
                {image && (
                  <img
                    class="tuile-image"
                    src={image.fichier ? withBase(image.fichier) : image.url}
                    alt={image.legende}
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <span class="tuile-texte-bloc">
                  <span class="tuile-numero">{String(index + 1).padStart(2, '0')}</span>
                  <span class="tuile-titre">{categorie.titre}</span>
                  <span class="tuile-texte">{categorie.resume}</span>
                </span>
              </a>
              {image && (
                <p class="credit-tuile">
                  {image.auteur}. {licence ? <a href={licence}>{image.licence}</a> : image.licence}.{' '}
                  <a href={image.url}>Wikimedia Commons</a>.
                </p>
              )}
            </li>
          );
        })
      }
    </ul>
  </section>

  <section class="bloc" aria-labelledby="titre-agenda">
    <h2 id="titre-agenda">Prochaines animations</h2>
    {
      evenements.length === 0 ? (
        <p class="vide">Aucune animation à venir.</p>
      ) : (
        <ul class="liste-agenda">
          {evenements.map((evenement) => (
            <li>
              <p class="carte-plage">{formatPlage(evenement.data.date_debut, evenement.data.date_fin)}</p>
              <h3>
                <a href={withBase(hrefFiche(evenement))}>{evenement.data.titre}</a>
              </h3>
              <p>
                {evenement.data.lieu} · {evenement.data.commune}
              </p>
              <p>{extrait(evenement.body, 180)}</p>
              <Statut statut={evenement.data.statut} />
            </li>
          ))}
        </ul>
      )
    }
    <p><a class="lien-suite" href={withBase('/agenda/')}>Ouvrir l’agenda</a></p>
  </section>
</Base>
