---
import Fil from '../components/Fil.astro';
import Base from '../layouts/Base.astro';
import { chargerSite } from '../lib/site';
import { withBase } from '../lib/urls';

const site = chargerSite();
const designs = [
  {
    id: 'revue',
    titre: 'Revue savante',
    texte: 'Page de journal : empagement étroit, caractères à empattements, tons de tuffeau et d’ardoise.',
  },
  {
    id: 'carnet',
    titre: 'Carnet de voyage',
    texte: 'Papier chaud, cartes postales et lavis. Le texte reste droit et large, pour être lu sans fatigue.',
  },
  {
    id: 'musee',
    titre: 'Musée',
    texte: 'Salle claire, grands titres sans empattement, cartels et beaucoup d’air, comme un parcours d’exposition.',
  },
  {
    id: 'contemporain',
    titre: 'Contemporain',
    texte: 'Page aérée, une seule typographie, vignettes sobres. Pas de grande image. Accent rouge, clair ou sombre selon l’écran.',
  },
  {
    id: 'minimal',
    titre: 'Minimal',
    texte: 'Fond blanc, JetBrains Mono, noir et gris. Le jaune sert de surlignage. Sept vignettes, une recherche, pas de carte sur l’accueil.',
  },
  {
    id: 'revue-marine',
    titre: 'Revue marine',
    texte: 'La revue savante, en bleu marine : pavés sur une ligne, carte à gauche, six vignettes à droite, animations en dessous.',
  },
];
const accueil = withBase('/');
---

<Base
  titre="Six designs"
  description="Comparer les six directions visuelles du site et choisir celle qui sera publiée."
>
  <Fil crumbs={[{ label: 'Six designs' }]} />
  <header class="entete-page">
    <h1>Six designs</h1>
    <p class="chapo">
      Le site publié utilise une seule valeur, <code>design</code>, dans le fichier
      <code>contenu/site.yml</code>. Aujourd’hui&nbsp;: <strong>{site.design}</strong>.
      On peut feuilleter les six présentations sans modifier ce fichier. Le choix
      «&nbsp;parcourir avec ce design&nbsp;» est gardé dans ce navigateur seulement.
    </p>
  </header>

  <ul class="choix-designs">
    {
      designs.map((design) => (
        <li>
          <h2>{design.titre}</h2>
          <p>{design.texte}</p>
          <p>
            <a href={`${accueil}?apercu=${design.id}`}>Ouvrir l’accueil</a>
          </p>
          <p>
            <button type="button" data-design-choice={design.id} data-href={accueil}>
              Parcourir le site avec ce design
            </button>
          </p>
        </li>
      ))
    }
  </ul>
  <p>
    <button type="button" data-design-reset data-href={accueil}>Revenir au design publié</button>
  </p>

  <h2>Côte à côte</h2>
  <p>Les six aperçus montrent la page d’accueil. Sur un petit écran, ils se suivent.</p>
  <div class="comparaison">
    {
      designs.map((design) => (
        <figure>
          <figcaption>{design.titre}</figcaption>
          <iframe title={`Aperçu ${design.titre}`} src={`${accueil}?apercu=${design.id}`} loading="lazy"></iframe>
        </figure>
      ))
    }
  </div>

  <script>
    const boutons = document.querySelectorAll<HTMLButtonElement>('[data-design-choice]');
    boutons.forEach((bouton) => {
      bouton.addEventListener('click', () => {
        const choix = bouton.dataset.designChoice;
        if (!choix) return;
        localStorage.setItem('pst-design', choix);
        const href = bouton.dataset.href;
        if (href) location.href = href;
      });
    });
    const reset = document.querySelector<HTMLButtonElement>('[data-design-reset]');
    reset?.addEventListener('click', () => {
      localStorage.removeItem('pst-design');
      const href = reset.dataset.href;
      if (href) location.href = href;
    });
  </script>
</Base>
