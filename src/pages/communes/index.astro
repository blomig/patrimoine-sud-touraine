---
import Fil from '../../components/Fil.astro';
import CarteTerritoire from '../../components/CarteTerritoire.astro';
import Base from '../../layouts/Base.astro';
import { communesCompletes } from '../../lib/contenu';
import { withBase } from '../../lib/urls';

const groupes = await communesCompletes();
---

<Base
  titre="Communes"
  description="Carte des 67 communes de Loches Sud Touraine, situées dans l’Indre-et-Loire. Le survol affiche le nom, le clic ouvre la page."
>
  <Fil crumbs={[{ label: 'Communes' }]} />
  <header class="entete-page">
    <h1>Communes</h1>
    <p class="chapo">
      Les 67 communes de la communauté de communes Loches Sud Touraine. Survolez un contour
      pour lire le nom, cliquez pour ouvrir la page. Les communes déjà documentées sont en
      bleu. Les autres ont quand même une page, avec la mention «&nbsp;fiches à venir&nbsp;».
    </p>
  </header>

  <CarteTerritoire identifiant="page-communes" />

  <h2>Les 67 communes</h2>
  <ul class="liste-communes">
    {
      groupes.map((commune) => (
        <li>
          <a href={withBase(`/communes/${commune.slug}/`)} class:list={[commune.fiches.length > 0 && 'commune-documentee']}>
            <span>{commune.nom}</span>
            <small>
              {commune.fiches.length > 0
                ? `${commune.fiches.length} fiche${commune.fiches.length > 1 ? 's' : ''}`
                : 'Fiches à venir'}
            </small>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
