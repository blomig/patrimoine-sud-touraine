---
import { chargerSite, listeCategories } from '../lib/site';
import { withBase } from '../lib/urls';

const site = chargerSite();
const ici = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const rubriques = [
  { href: withBase('/communes/'), label: 'Communes', animations: false },
  ...listeCategories().map((categorie) => ({
    href: withBase(`/${categorie.id}/`),
    label: categorie.titre,
    animations: categorie.id === 'agenda',
  })),
];
const liens = [
  { href: withBase('/'), label: 'Accueil' },
  { href: withBase('/qu-est-ce-que-ce-site/'), label: 'Qu’est-ce que ce site ?' },
  { href: withBase('/frise/'), label: 'Frise chronologique' },
  { href: withBase('/associations/'), label: 'Annuaire' },
  { href: withBase('/recherche/'), label: 'Recherche' },
];

function estIci(href: string): boolean {
  return ici === href || ici.startsWith(href);
}
---

<header class="entete" data-pagefind-ignore>
  <div class="entete-haut">
    <p class="marque marque-revue">Cahier documentaire · Indre-et-Loire</p>
    <p class="marque marque-carnet">Carnet de voyage</p>
    <p class="marque marque-musee">Parcours musée</p>
    <a class="nom-site" href={withBase('/')}>{site.titre}</a>
    <p class="sous-titre">Communauté de communes Loches Sud Touraine</p>
  </div>
  <div class="barre-menu">
    <nav class="nav-rubriques" aria-label="Communes et rubriques">
      {
        rubriques.map((rubrique) => (
          <a
            class:list={['nav-pastille', rubrique.animations && 'nav-pastille-animations']}
            href={rubrique.href}
            aria-current={estIci(rubrique.href) ? 'page' : undefined}
          >
            {rubrique.label}
          </a>
        ))
      }
    </nav>
    <form class="recherche-menu" role="search" action={withBase('/recherche/')} method="get">
      <label class="masque" for="recherche-menu">Rechercher dans le site</label>
      <input id="recherche-menu" type="search" name="q" placeholder="Rechercher une fiche…" autocomplete="off" enterkeyhint="search" />
      <button type="submit" aria-label="Rechercher">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="10.5" cy="10.5" r="6.25" fill="none" stroke="currentColor" stroke-width="2"></circle>
          <path d="M15.2 15.2 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
      </button>
    </form>
    <details class="menu">
      <summary>Menu</summary>
      <nav class="nav-principal" aria-label="Navigation principale">
        {liens.map((lien) => (
          <a href={lien.href} aria-current={ici === lien.href ? 'page' : undefined}>
            {lien.label}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.menu');
  const large = window.matchMedia('(min-width: 64rem)');
  const ajuster = () => {
    if (!menu) return;
    if (large.matches) menu.open = true;
  };
  ajuster();
  large.addEventListener('change', ajuster);
</script>
