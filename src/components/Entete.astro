---
import { toutesLesFiches } from '../lib/contenu';
import { appliquerNombre } from '../lib/nombres';
import { chargerSite, listeCategories } from '../lib/site';
import { withBase } from '../lib/urls';

const site = chargerSite();
const fiches = await toutesLesFiches();
const nombreFiches = fiches.filter((fiche) => fiche.data.categorie !== 'agenda').length;
const sousTitre = appliquerNombre(site.sous_titre, nombreFiches);
const ici = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const rubriques = listeCategories().map((categorie) => ({
  href: withBase(`/${categorie.id}/`),
  label: categorie.titre,
  id: categorie.id,
  animations: categorie.id === 'agenda',
}));
const principales = rubriques.filter((rubrique) => !rubrique.animations);
const animations = rubriques.find((rubrique) => rubrique.animations);

function estIci(href: string): boolean {
  return ici === href || ici.startsWith(href);
}
---

<header class="entete" data-pagefind-ignore>
  <div class="entete-bloc">
    <div class="entete-haut">
      <a class="nom-site" href={withBase('/')}>{site.titre}</a>
      <p class="sous-titre">{sousTitre}</p>
    </div>
    <div class="barre-menu">
      <nav class="nav-rubriques" aria-label="Rubriques">
        {
          principales.map((rubrique) => (
            <a
              class="nav-pastille"
              data-rubrique={rubrique.id}
              href={rubrique.href}
              aria-current={estIci(rubrique.href) ? 'page' : undefined}
            >
              {rubrique.label}
            </a>
          ))
        }
      </nav>
      <div class="ligne-animations">
        {
          animations && (
            <a
              class="nav-pastille nav-pastille-animations"
              data-rubrique={animations.id}
              href={animations.href}
              aria-current={estIci(animations.href) ? 'page' : undefined}
            >
              {animations.label}
            </a>
          )
        }
        <form class="recherche-menu" role="search" action={withBase('/recherche/')} method="get">
          <label class="masque" for="recherche-menu">Rechercher dans le site</label>
          <input id="recherche-menu" type="search" name="q" placeholder="Rechercher une fiche…" autocomplete="off" enterkeyhint="search" />
          <button type="submit" aria-label="Rechercher">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="10.5" cy="10.5" r="6.25" fill="none" stroke="currentColor" stroke-width="2"></circle>
              <path d="M15.2 15.2 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
            </svg>
          </button>
        </form>
      </div>
    </div>
  </div>
</header>
