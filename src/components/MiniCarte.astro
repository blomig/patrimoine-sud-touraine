---
import 'leaflet/dist/leaflet.css';

const { latitude, longitude, identifiant } = Astro.props as {
  latitude: number;
  longitude: number;
  identifiant: string;
};
---

<div
  class="mini-carte"
  id={`mini-${identifiant}`}
  data-lat={latitude}
  data-lon={longitude}
  role="region"
  aria-label="Situation sur une carte"
></div>

<script>
  import L from 'leaflet';

  if (document.documentElement.dataset.design === 'contemporain') {
    document.querySelectorAll<HTMLElement>('.mini-carte[data-lat]').forEach((el) => {
      if (el.dataset.pret === '1') return;
      el.dataset.pret = '1';
      const lat = Number(el.dataset.lat);
      const lon = Number(el.dataset.lon);
      const plan = L.map(el, { scrollWheelZoom: false });
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 18,
        attribution: '&copy; OpenStreetMap',
      }).addTo(plan);
      L.circleMarker([lat, lon], {
        radius: 9,
        color: '#ffffff',
        weight: 2,
        fillColor: '#c62828',
        fillOpacity: 1,
      }).addTo(plan);
      plan.setView([lat, lon], 15);
      requestAnimationFrame(() => plan.invalidateSize());
    });
  }
</script>
