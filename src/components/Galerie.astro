---
import { withBase } from '../lib/urls';

const { images } = Astro.props as {
  images: { src: string; legende?: string; credit: string }[];
};

function adresse(src: string): string {
  if (/^https?:\/\//.test(src)) return src;
  return withBase(src.startsWith('/') ? src : `/${src}`);
}
---

{
  images.length > 0 && (
    <section class="galerie" aria-labelledby="titre-galerie">
      <h2 id="titre-galerie">Galerie</h2>
      <ul>
        {images.map((image) => (
          <li>
            <figure>
              <img src={adresse(image.src)} alt={image.legende || 'Carte postale ancienne'} loading="lazy" decoding="async" />
              <figcaption>
                {image.legende ? <span>{image.legende}</span> : null}
                <span>{image.credit}</span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </section>
  )
}
